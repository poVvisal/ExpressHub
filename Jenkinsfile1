pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        AWS_ACCESS_KEY_ID       = "something"
        AWS_SECRET_ACCESS_KEY   = "secret"        
        AWS_DEFAULT_REGION      = "us-east-1"
        
        TF_DIR                  = "terraform/dev"
        
        // TF might still complain if required vars are missing during destroy evaluation
        TF_VAR_grafana_password = "khmer4ever" 
    }

    stages {
        stage('Clone Repo') {
            steps {
                git branch: "main", url: 'https://github.com/poVvisal/ExpressHub.git'
            }
        }

        stage('Connect & Nuke (Terraform Destroy)') {
            steps {
                dir("${env.TF_DIR}") {
                    sh '''#!/bin/bash
                        set -euo pipefail
                        
                        echo "Connecting to remote S3 backend..."
                        terraform init -input=false
                        
                        echo "Dropping the hammer on the EC2 instances..."
                        # Auto-approve so it doesn't hang waiting for you to type 'yes'
                        terraform destroy -auto-approve
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Cleanup complete. Your AWS free tier is safe for another day."
            cleanWs(deleteDirs: true, disableDeferredWipeout: true)
        }
    }
}